# copy this to .env and fill in real values
# .env is git-ignored, never commit real credentials

# postgres connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://vonbook:vonbook_dev_password@localhost:5434/vonbook

# ssl is auto-detected from the DATABASE_URL hostname (off for localhost, on
# otherwise). only set this if that guess is wrong.
# DATABASE_SSL=true

# port express (and the socket.io server riding on the same http server) listens on
PORT=4000

# comma separated list of origins allowed to open a socket (REST calls are
# proxied through the frontend's own domain in production -- see
# frontend/vercel.json -- so this mainly matters for the Socket.IO
# connection, which the frontend still makes directly to this backend).
# in production this must be your deployed frontend's exact url (e.g.
# https://vonbook-xxxx.vercel.app) -- see the Deploying section of the
# root README.md
CORS_ORIGIN=http://localhost:5173

# max upload size in mb for post photos/videos and avatars
MAX_UPLOAD_MB=50

# --- auth / sessions ---
# no JWT signing secret here on purpose: sessions are opaque random tokens
# looked up (and revocable) in the `sessions` table, not signed JWTs.

# controls the session + csrf cookies' Secure attribute (SameSite is
# always Lax -- see lib/session.js for why that's safe here even though
# the frontend and backend are on different domains: REST calls are
# proxied through the frontend's own origin, so the browser only ever
# sees same-origin requests). leave unset and Secure is inferred from
# NODE_ENV=production. only override if that guess is wrong.
# COOKIE_SECURE=true

# --- the birthday boy's account ---
# whoever signs up with this exact code in the "founder code" field on the
# signup form gets is_founder=true -- the special profile treatment (see
# backend/src/routes/auth.js and frontend/src/pages/Signup.jsx). the
# database enforces only one account can ever hold it (idx_users_one_founder
# in database/schema.sql), so this code is safe to share with exactly one
# person and nobody else who signs up later can claim it even if they guess
# it. pick something only your son would know/receive from you.
FOUNDER_CLAIM_CODE=change-me-to-something-only-he-knows

# --- password reset emails (optional, fail-open) ---
# sent when someone uses "forgot password". leaving SMTP_HOST unset just
# logs the reset link to the server console instead of emailing it (see
# lib/mailer.js) -- fine for local dev, but means resets aren't actually
# usable in production until this is set. any real smtp provider works
# here (a free tier from Mailtrap, Resend, Brevo, or Gmail's smtp with an
# app password).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="VonBook <noreply@example.com>"

# --- file storage (optional, fail-open) ---
# leaving this unset stores avatars/covers/post media on local disk (see
# middleware/upload.js) -- fine for local dev, but on Render's free tier
# that disk is wiped on every redeploy (see render.yaml). set this to move
# uploads to Cloudinary's free tier instead, which survives redeploys. get
# this from your Cloudinary dashboard's "API Environment variable" box --
# it already comes formatted exactly like this, just paste it as-is:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# one-time secret for POST /api/admin/migrate-media (see routes/admin.js) --
# only needed transiently, to move pre-existing /uploads/... files over to
# their new cloudinary urls after CLOUDINARY_URL above is first set up.
# pick any random string; safe to remove this var (and the route) once
# that's been run against production once.
# MIGRATION_KEY=
