# copy to .env for local dev

# backend api base url. locally this points straight at the backend; in
# production leave this UNSET -- the code defaults to the relative "/api",
# which vercel.json rewrites to the Render backend so the browser only
# ever talks to this site's own origin (needed for the session cookie to
# work at all, see backend/src/lib/session.js). Setting this on Vercel to
# the Render URL directly, like a naive first pass at this might do, is
# exactly what breaks login: the cookie becomes a third-party cookie and
# most browsers silently drop it.
VITE_API_URL=http://localhost:4000/api

# backend socket.io url (same host, no /api suffix). unlike VITE_API_URL,
# this DOES stay set to the real backend URL in production too -- the
# socket connects to Render directly either way (see
# frontend/src/context/SocketContext.jsx for how it authenticates without
# relying on the cookie for that cross-site connection).
VITE_SOCKET_URL=http://localhost:4000
